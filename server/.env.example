# Port for Express API server (Render automatically sets process.env.PORT)
PORT=5000

# LLM Provider Configuration: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if LLM_PROVIDER is set to openai)
OPENAI_API_KEY=

# Frontend Production URL for CORS (e.g., https://your-frontend-app.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app
