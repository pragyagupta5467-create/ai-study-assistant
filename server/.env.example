# Port for Express API server
PORT=5000

# LLM Provider Configuration
# Choose: "gemini" or "openai" or "mock" (leave empty or set to gemini by default)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if LLM_PROVIDER is set to openai)
OPENAI_API_KEY=
